.env
.env.*
!.env.example
local.properties
!local.properties.example
**/Config.xcconfig
!**/Config.xcconfig.example
google-services.json
GoogleService-Info.plist
!**/google-services.json.example
!**/GoogleService-Info.plist.example
*.keystore
*.jks
*.p12
*.mobileprovision
*.cer
serviceAccount*.json
*-service-account.json
# Public tracking page needs a web app config at deploy time; the example is committed.
hosting/public/firebase-config.js
!hosting/public/firebase-config.example.js
# Cloud Functions secrets / emulator data
functions/.secret.local
functions/**/.runtimeconfig.json
.secret.local
emulator-data/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
# Firebase Emulator Hub ports
.firebase/

