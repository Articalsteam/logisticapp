# -----------------------------------------------------------------------------
# Cloud Functions environment (server side only — NEVER commit real values).
# Deploy secrets with:  firebase functions:secrets:set <NAME>
# Local emulator usage: copy to .env.local (git-ignored) or use .secret.local.
# -----------------------------------------------------------------------------

# --- Firebase project --------------------------------------------------------
# Set automatically by the Firebase runtime; only needed for local scripts.
GCLOUD_PROJECT=demo-articals

# --- Routing / mapping provider ---------------------------------------------
# provider: "google_routes" | "mapbox_directions" | "manual_only"
ROUTING_PROVIDER=manual_only
# Server-side key for the routing provider. Prefer the secret below in production:
ROUTING_API_KEY=
# Secret names expected by the code when ROUTING_API_KEY is absent:
#   GOOGLE_ROUTES_API_KEY  (Google Routes API: routes.googleapis.com)
#   MAPBOX_ACCESS_TOKEN    (Mapbox Directions API)
# Region hint used by the Google Routes API request (optional).
ROUTING_REGION_CODE=NG

# --- Web / links -------------------------------------------------------------
# Public base URL used to build customer tracking links.
PUBLIC_TRACKING_BASE_URL=https://track.articals.example
PUBLIC_MARKETING_URL=https://articals.example

# --- Public tracking abuse control ------------------------------------------
TRACKING_RATE_LIMIT_PER_WINDOW=30
TRACKING_RATE_LIMIT_WINDOW_SECONDS=600

# --- Emulator wiring (used only by local scripts; harmless in production) ----
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=
