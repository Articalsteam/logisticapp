rules_version = '2';

// =============================================================================
// Articals Logistics — Firestore security rules
//
// Design (ADR-004): the mobile app never writes business data directly. Every
// mutation goes through a Cloud Function that validates input, authorization,
// entitlement and business rules, and writes with the Admin SDK. These rules
// therefore enforce one thing extremely well: WHICH DOCUMENTS A USER MAY READ.
//
// Consequences you should rely on:
//   * `allow write: if false` everywhere means a compromised client cannot forge an
//     order, a price, a role, a rider payment or a subscription state;
//   * tenant isolation is checked on every read from the caller's own membership
//     document, never from a value supplied by the app;
//   * riders can only read deliveries assigned to them, and nothing financial;
//   * platform-admin authority comes from a custom claim written by trusted code,
//     so `role: "admin"` in a request or a document field means nothing.
//
// The Admin SDK bypasses these rules, which is exactly why every function performs
// its own checks (see functions/src/shared/auth.ts).
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isPlatformAdmin() {
      return signedIn() && request.auth.token.platformAdmin == true;
    }

    function membershipPath(tenantId) {
      return /databases/$(database)/documents/memberships/$(tenantId + '_' + uid());
    }

    function membership(tenantId) {
      return get(membershipPath(tenantId)).data;
    }

    function hasMembership(tenantId) {
      return signedIn() && exists(membershipPath(tenantId));
    }

    // Only an ACTIVE membership counts. A disabled staff member keeps their history
    // but loses all read access immediately.
    function isMemberOf(tenantId) {
      return hasMembership(tenantId) && membership(tenantId).status == 'active';
    }

    function roleIn(tenantId, allowedRoles) {
      return isMemberOf(tenantId) && membership(tenantId).role in allowedRoles;
    }

    function isOwner(tenantId) { return roleIn(tenantId, ['owner']); }
    function isStaff(tenantId) { return roleIn(tenantId, ['owner', 'manager', 'dispatcher']); }
    function isRider(tenantId) { return roleIn(tenantId, ['rider']); }

    // Extra permissions an owner granted, minus any they revoked. Owners always hold
    // the full set on the backend, so they are treated as unrestricted here too.
    function hasPermission(tenantId, permission) {
      return isMemberOf(tenantId) && (
        membership(tenantId).role == 'owner'
        || (
          (membership(tenantId).grantedPermissions == null || permission in membership(tenantId).grantedPermissions)
          && (membership(tenantId).revokedPermissions == null || !(permission in membership(tenantId).revokedPermissions))
          && permission in rolePermissions(tenantId)
        )
      );
    }

    // Mirrors ROLE_PERMISSIONS in functions/src/domain/permissions.ts. Kept in sync by
    // tests/rules/firestore.rules.test.ts, which asserts the security-relevant subset.
    function rolePermissions(tenantId) {
      return membership(tenantId).role == 'manager'
        ? [
            'company.settings.view', 'staff.view', 'pricing.view', 'pricing.manage', 'quotes.create',
            'orders.view_all', 'orders.create', 'orders.update', 'orders.cancel', 'orders.assign',
            'orders.correct_status', 'orders.update_status', 'orders.record_actuals', 'orders.record_proof',
            'riders.view', 'riders.manage', 'customers.view', 'customers.manage',
            'expenses.view', 'expenses.manage', 'reports.view_operational', 'reports.view_financial',
            'reports.export', 'tracking.share_link'
          ]
        : membership(tenantId).role == 'dispatcher'
        ? [
            'company.settings.view', 'pricing.view', 'quotes.create', 'orders.view_all', 'orders.create',
            'orders.update', 'orders.assign', 'orders.update_status', 'orders.record_actuals',
            'orders.record_proof', 'riders.view', 'customers.view', 'customers.manage',
            'expenses.view', 'expenses.manage', 'reports.view_operational', 'tracking.share_link'
          ]
        : membership(tenantId).role == 'rider'
        ? ['orders.view_assigned', 'orders.update_status', 'orders.record_proof']
        : [];
    }

    function riderProfileId(tenantId) {
      return membership(tenantId).riderId;
    }

    // -------------------------------------------------------------------------
    // users — a person's own profile only
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if signedIn() && (userId == uid() || isPlatformAdmin());
      // Device tokens and profile edits are written by `registerDeviceToken` /
      // trusted functions so that a token cannot be attached to another account.
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // companies — members read their own workspace
    // -------------------------------------------------------------------------
    match /companies/{tenantId} {
      allow read: if isMemberOf(tenantId) || isPlatformAdmin();
      allow write: if false;   // createCompany / updateCompanySettings only
    }

    // -------------------------------------------------------------------------
    // memberships — own membership, or staff with staff.view
    // -------------------------------------------------------------------------
    match /memberships/{membershipId} {
      // The document id is `${tenantId}_${userId}`; splitting it avoids a get()
      // just to discover which tenant the membership belongs to.
      function tenantOf() {
        return membershipId.split('_')[0];
      }
      allow read: if signedIn() && (
        membershipId == tenantOf() + '_' + uid()
        || resource.data.userId == uid()
        || isOwner(tenantOf())
        || hasPermission(tenantOf(), 'staff.view')
        || isPlatformAdmin()
      );
      allow write: if false;   // inviteCompanyMember / acceptInvitation / updateMemberRole only
    }

    // Invitations are resolved by trusted functions; clients never read them.
    match /invitations/{invitationId} {
      allow read, write: if false;
    }

    match /riderInvitations/{token} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // pricingConfigs — staff with pricing.view
    // -------------------------------------------------------------------------
    match /pricingConfigs/{configId} {
      match /versions/{versionId} {
        allow read: if resource.data.tenantId != null && hasPermission(resource.data.tenantId, 'pricing.view');
        allow write: if false;
      }
      allow read: if resource.data.tenantId != null && hasPermission(resource.data.tenantId, 'pricing.view');
      allow write: if false;   // updateCompanyPricing only
    }

    // Quotes are working documents for dispatchers.
    match /quotes/{quoteId} {
      allow read: if resource.data.tenantId != null && hasPermission(resource.data.tenantId, 'quotes.create');
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // customers — staff with customers.view (riders never see the customer book)
    // -------------------------------------------------------------------------
    match /customers/{customerId} {
      allow read: if resource.data.tenantId != null && hasPermission(resource.data.tenantId, 'customers.view');
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // riders — staff with riders.view; a rider may read their own profile
    // -------------------------------------------------------------------------
    match /riders/{riderId} {
      allow read: if resource.data.tenantId != null && (
        hasPermission(resource.data.tenantId, 'riders.view')
        || (isRider(resource.data.tenantId) && resource.data.userId == uid())
      );
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // orders — staff see the company's orders; a rider sees only their own
    // -------------------------------------------------------------------------
    match /orders/{orderId} {
      function tenantOf() { return resource.data.tenantId; }

      allow read: if resource.data.tenantId != null && (
        hasPermission(tenantOf(), 'orders.view_all')
        || (
          hasPermission(tenantOf(), 'orders.view_assigned')
          && resource.data.assignedRiderId != null
          && resource.data.assignedRiderId == riderProfileId(tenantOf())
        )
      );

      match /deliveryEvents/{eventId} {
        // Same rule as the parent order, so a rider can follow their own delivery's
        // history but nobody can read another delivery's events by guessing an id.
        allow read: if get(/databases/$(database)/documents/orders/$(orderId)).data.tenantId != null && (
          hasPermission(
            get(/databases/$(database)/documents/orders/$(orderId)).data.tenantId,
            'orders.view_all'
          )
          || (
            hasPermission(
              get(/databases/$(database)/documents/orders/$(orderId)).data.tenantId,
              'orders.view_assigned'
            )
            && get(/databases/$(database)/documents/orders/$(orderId)).data.assignedRiderId == riderProfileId(
              get(/databases/$(database)/documents/orders/$(orderId)).data.tenantId
            )
          )
        );
        allow write: if false;
      }

      allow write: if false;   // createOrder / updateOrder / updateDeliveryStatus only
    }

    // -------------------------------------------------------------------------
    // expenses — owner, manager and dispatcher
    // -------------------------------------------------------------------------
    match /expenses/{expenseId} {
      allow read: if resource.data.tenantId != null && hasPermission(resource.data.tenantId, 'expenses.view');
      allow write: if false;
    }

    // Daily rollups contain revenue and profit: restricted to staff who may see
    // financial reporting, which excludes dispatchers.
    match /companyDailyStats/{docId} {
      allow read: if resource.data.tenantId != null && hasPermission(resource.data.tenantId, 'reports.view_financial');
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // subscriptions — status and dates only, and only for owners
    // -------------------------------------------------------------------------
    match /subscriptions/{tenantId} {
      allow read: if isOwner(tenantId) || isPlatformAdmin();

      // Billing internals, ledger history and evidence are platform-admin only. The
      // Admin SDK ignores these rules, so the admin app reads through functions.
      match /private/{docId} {
        allow read, write: if false;
      }
      match /ledger/{entryId} {
        allow read, write: if false;
      }
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // platformConfig — the plan catalogue is readable so owners can see pricing;
    // everything else is admin-only.
    // -------------------------------------------------------------------------
    match /platformConfig/{docId} {
      allow read: if signedIn() && docId == 'plans';
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Never readable from a client, by anyone.
    //
    //   publicTracking        — served only through getPublicTracking (rate limited);
    //   auditLogs             — contains the who/what/why of every sensitive action;
    //   idempotencyKeys       — request fingerprints;
    //   counters              — order-number sequences;
    //   rateLimits            — abuse-control buckets (hashed keys);
    //   notificationOutbox    — outbound push queue processed by a trigger;
    //   companyDailyStats is above; subscriptions internals are above.
    // -------------------------------------------------------------------------
    match /publicTracking/{reference} { allow read, write: if false; }
    match /auditLogs/{logId} { allow read, write: if false; }
    match /idempotencyKeys/{keyId} { allow read, write: if false; }
    match /counters/{counterId} { allow read, write: if false; }
    match /rateLimits/{bucketId} { allow read, write: if false; }
    match /notificationOutbox/{entryId} { allow read, write: if false; }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
