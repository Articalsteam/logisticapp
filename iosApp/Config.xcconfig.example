// Copy this file to `Config.xcconfig` and fill in your own values.
//
// `Config.xcconfig` is git-ignored: it names your Apple Developer team and your
// bundle identifiers, which differ per developer and per build channel.

// --- Signing ---------------------------------------------------------------
// Your 10-character Apple Developer Team ID. Xcode shows it under
// Signing & Capabilities, or in the Apple Developer portal.
DEVELOPMENT_TEAM = REPLACE_WITH_TEAM_ID

// --- Bundle identifiers ----------------------------------------------------
// Keep the .admin suffix for the console build: it lets both apps be installed
// side by side on one device during the pilot.
PRODUCT_BUNDLE_IDENTIFIER = com.articals.logistics
PRODUCT_BUNDLE_IDENTIFIER_ADMIN = com.articals.logistics.admin

// --- App Check (debug builds only) ----------------------------------------
// A debug token is a secret while it is valid: it lets an unregistered debug build
// pass App Check. Never put this value in a release configuration and never commit
// it. Register the token in Firebase console → App Check → Apps → Manage debug tokens.
APPCHECK_DEBUG_TOKEN = REPLACE_OR_LEAVE_BLANK

// --- Versioning ------------------------------------------------------------
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// --- Firebase --------------------------------------------------------------
// The iOS app reads its configuration from GoogleService-Info.plist (downloaded
// from the Firebase console, not committed). These flags only choose which parts of
// the SDK are linked into the shell.
FIREBASE_ANALYTICS_ENABLED = NO
CRASHLYTICS_ENABLED = YES
