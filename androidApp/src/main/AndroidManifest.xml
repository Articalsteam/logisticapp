<?xml version="1.0" encoding="utf-8"?>
<!--
  Articals Logistics — Android entry point.

  Deliberately thin: the manifest, the launcher activity, the application icon and
  the Firebase configuration file live here; every screen, every view model and all
  business logic live in :composeApp so that Android and iOS run one implementation
  (ADR-012).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Asked for at the point where a rider marks a delivery delivered, never at
         launch. There is no location, contacts or background-location permission in
         this app at all: the MVP does not track devices (spec §1). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ArticalsApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArticalsLogistics">

        <!--
          Firebase is initialised explicitly, and only in a FIREBASE build. Removing the
          automatic initialiser is what makes "demo mode initialises nothing Firebase"
          literally true even on a device that happens to have google-services.json
          installed: the SDK is never started unless the mode asks for it.
        -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />

        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|fontScale|locale|layoutDirection|density|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Rider invitations. The hosting page at /rider-invite shows the token; the
              same link opens the app directly when it is installed.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="articals" android:host="rider-invite" />
            </intent-filter>
        </activity>
    </application>

</manifest>
